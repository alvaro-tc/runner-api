# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Prefijo del dominio publico de la API. En produccion, el dominio real del VPS.
API_DOMAIN=api.paceup.example
# Origenes permitidos por CORS, separados por coma. "*" solo en desarrollo.
CORS_ORIGINS=*

# ─── Base de datos ────────────────────────────────────────────────────────────
# Formato Prisma. Postgres corre nativamente: host "localhost" en desarrollo.
DATABASE_URL=postgresql://paceup:paceup@localhost:5432/paceup?schema=public

# ─── Redis (cache, colas BullMQ, adapter de Socket.IO) ────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# true = salida coloreada legible (solo desarrollo). false = JSON.
LOG_PRETTY=true

# ─── Zona horaria por defecto de las maratones (IANA) ─────────────────────────
DEFAULT_TIMEZONE=America/La_Paz

# ─── Datos fiscales del comprobante (placeholders, editables en el panel) ─────
INVOICE_LEGAL_NAME=PaceUp SRL
INVOICE_NIT=0000000000
INVOICE_ADDRESS=La Paz, Bolivia

# ─── Pagos (proveedor simulado) ───────────────────────────────────────────────
# Latencia artificial del mock, en ms. Un cobro que responde en 2 ms deja la UI
# sin loaders y esconde los bugs de estado que solo aparecen con red lenta.
PAYMENT_MOCK_LATENCY_MIN_MS=300
PAYMENT_MOCK_LATENCY_MAX_MS=1500
# Ventana de validez del QR. Vencido, hay que pedir uno nuevo.
PAYMENT_QR_TTL_MINUTES=10
# Segundos que tarda el QR mock en "pagarse" solo, para que el polling del
# cliente tenga algo real que observar. 0 lo confirma en el primer sondeo.
PAYMENT_QR_AUTO_CONFIRM_SECONDS=8

# ─── Datos bancarios mock del metodo bank_transfer ────────────────────────────
PAYMENT_BANK_NAME=Banco Nacional de Bolivia
PAYMENT_BANK_ACCOUNT=1000-0000-0000
PAYMENT_BANK_ACCOUNT_TYPE=Caja de ahorro

# ─── Webhook del proveedor de pagos ───────────────────────────────────────────
# Secreto con el que se firma y verifica el webhook. El valor por defecto NO se
# acepta en produccion: generalo con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-de-desarrollo
# Tolerancia de la marca de tiempo, en segundos. Fuera de esta ventana el
# webhook se rechaza aunque la firma sea correcta: impide reenviar uno viejo.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ─── Limites ──────────────────────────────────────────────────────────────────
# Tamano maximo del body JSON (ej. lotes de posiciones GPS comprimidos).
BODY_LIMIT=2mb

# ─── Prisma: base espejo para detectar drift al crear migraciones ────────────
# Solo la usa `prisma migrate dev` en desarrollo. En produccion no hace falta.
SHADOW_DATABASE_URL=postgresql://paceup:paceup@localhost:5432/paceup_shadow?schema=public

# ─── Autenticacion ────────────────────────────────────────────────────────────
# Secreto de firma del access token. SIN DEFAULT a proposito: un secreto por
# defecto es un secreto publico. Genera el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAME_genera_uno_propio_de_al_menos_32_caracteres
# Access token corto: si se filtra, caduca solo.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh de 60 dias que rota en cada uso: el usuario no vuelve a loguearse
# mientras abra la app cada tanto.
REFRESH_TOKEN_TTL_DAYS=60
PASSWORD_RESET_TTL_MINUTES=60
# Intentos por minuto y por IP en los endpoints con credenciales.
# Es una perilla de calibracion: 10 no molesta a quien escribe mal la clave y
# corta el ataque automatizado, pero detras de un NAT compartido (una oficina,
# una red movil) puede quedarse corto. Subilo si ves 429 legitimos.
AUTH_RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=120
# Lotes de posiciones por minuto y POR SESION, no por IP: media maraton entera
# sale por la misma red movil con la misma IP publica. El ritmo normal son 2-4
# lotes (uno cada 15-30 s); el resto es margen para el cliente que drena su cola
# acumulada al salir de un tunel.
TRACKING_INGEST_BATCHES_PER_MINUTE=20
# Puntos por minuto y por dispositivo en el endpoint OsmAnd (un punto por peticion).
TRACKING_OSMAND_POINTS_PER_MINUTE=120

# ─── Tiempo real ────────────────────────────────────────────────────────────────
# Cada cuanto, como maximo, llega una posicion de un mismo corredor al mapa de
# espectadores. Bajarlo multiplica el trafico sin que el mapa se vea mejor.
LIVE_UPDATE_MIN_INTERVAL_MS=5000

# ─── Archivos subidos (avatares, tarjetas de resultado) ───────────────────────
# Raiz del driver local de StorageService. Se sirve estaticamente en /uploads.
UPLOADS_DIR=./uploads
# Base publica con la que se arman las URLs de los archivos. En el VPS,
# https://<API_DOMAIN>. Cambiarla no invalida nada: en la BD se guarda la clave
# del archivo, no la URL completa.
PUBLIC_BASE_URL=http://localhost:3000
# Tamano maximo del avatar ANTES de procesar (5 MB).
AVATAR_MAX_BYTES=5242880
# Lado del avatar cuadrado que se guarda.
AVATAR_SIZE_PX=512
# Tamano maximo de la portada de una maraton ANTES de procesar (8 MB).
MARATHON_COVER_MAX_BYTES=8388608
# Ancho maximo al que se reescala la portada guardada.
MARATHON_COVER_MAX_WIDTH_PX=1600

# ─── App movil: enlaces profundos y version minima ──────────────────────────────
# Esquema propio de la app. Es lo que abre el telefono desde /links/*.
APP_LINK_SCHEME=paceup
# Version minima soportada de la app (semver). El cliente la lee en /config/app
# y bloquea si la suya es menor. Subirla es una decision de producto: por eso es
# variable de entorno y no una constante del codigo.
MIN_APP_VERSION=1.0.0
# Fichas de tienda para quien abre un enlace compartido sin tener la app.
# Vacias mientras no haya publicacion: la pagina no pinta el boton y ya.
# APP_STORE_URL=https://apps.apple.com/app/id000000000
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=bo.paceup.app

# --- Cobro por QR manual (TEMPORAL, ver docs/pago-qr-manual.md) -------------
PAYMENT_PROOF_MAX_BYTES=8388608
PAYMENT_PROOF_MAX_WIDTH_PX=1600
PAYMENT_PROOF_TTL_HOURS=48
PUBLIC_REGISTRATION_ENABLED=true
